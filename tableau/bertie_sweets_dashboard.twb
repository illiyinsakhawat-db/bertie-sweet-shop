    <column caption="Discount Pct" datatype="real" name="[discount_pct]" role="measure" type="quantitative" />
    <column caption="Price Status" datatype="string" name="[price_status]" role="dimension" type="nominal" />
    <column caption="Gross Revenue" datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[gross_revenue]" role="measure" type="quantitative" />
    <column caption="Discount Amount" datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[discount_amount]" role="measure" type="quantitative" />
