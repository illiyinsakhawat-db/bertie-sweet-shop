  <datasource caption="Order Summary" inline='true' name="federated.order_summary" version='18.1'>
    <connection class='federated'>
      <named-connections>
        <named-connection caption="order_summary" name="textscan.order_summary">
          <connection class='textscan' directory="/Users/illiyinsakhawat/Projects/bertie-sweet-shop/tableau/data" filename="order_summary.csv" password='' server='' />
        </named-connection>
      </named-connections>
      <relation connection="textscan.order_summary" name="order_summary.csv" table="[order_summary#csv]" type='table'>
        <columns character-set='UTF-8' header='yes' locale='en_GB' separator=','>
            <column datatype="integer" name="order_id" ordinal="0" />
            <column datatype="integer" name="customer_id" ordinal="1" />
            <column datatype="date" name="order_date" ordinal="2" />
            <column datatype="date" name="order_month" ordinal="3" />
            <column datatype="string" name="order_status" ordinal="4" />
            <column datatype="string" name="region_name" ordinal="5" />
            <column datatype="integer" name="line_count" ordinal="6" />
            <column datatype="integer" name="units" ordinal="7" />
            <column datatype="real" name="gross_subtotal" ordinal="8" />
            <column datatype="real" name="discount_total" ordinal="9" />
            <column datatype="real" name="delivery_charge" ordinal="10" />
            <column datatype="real" name="order_total" ordinal="11" />
            <column datatype="integer" name="customer_order_seq" ordinal="12" />
            <column datatype="real" name="days_since_prev_order" ordinal="13" />
            <column datatype="string" name="new_vs_repeat" ordinal="14" />
        </columns>
      </relation>
    </connection>
    <aliases enabled='yes' />
    <column caption="Order Id" datatype="integer" name="[order_id]" role="dimension" type="ordinal" />
    <column caption="Customer Id" datatype="integer" name="[customer_id]" role="dimension" type="ordinal" />
    <column caption="Order Date" datatype="date" name="[order_date]" role="dimension" type="ordinal" />
    <column caption="Order Month" datatype="date" name="[order_month]" role="dimension" type="ordinal" />
    <column caption="Order Status" datatype="string" name="[order_status]" role="dimension" type="nominal" />
    <column caption="Region Name" datatype="string" name="[region_name]" role="dimension" type="nominal" />
    <column caption="Line Count" datatype="integer" name="[line_count]" role="measure" type="quantitative" />
    <column caption="Units" datatype="integer" name="[units]" role="measure" type="quantitative" />
    <column caption="Gross Subtotal" datatype="real" name="[gross_subtotal]" role="measure" type="quantitative" />
    <column caption="Discount Total" datatype="real" name="[discount_total]" role="measure" type="quantitative" />
    <column caption="Delivery Charge" datatype="real" name="[delivery_charge]" role="measure" type="quantitative" />
    <column caption="Order Total" datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[order_total]" role="measure" type="quantitative" />
    <column caption="Customer Order Seq" datatype="integer" name="[customer_order_seq]" role="dimension" type="ordinal" />
    <column caption="Days Since Prev Order" datatype="real" name="[days_since_prev_order]" role="measure" type="quantitative" />
    <column caption="New Vs Repeat" datatype="string" name="[new_vs_repeat]" role="dimension" type="nominal" />
    <column caption="Avg Order Value" datatype="real" default-format='c"£"#,##0.00;-"£"#,##0.00' name="[Calc_AOV]" role="measure" type="quantitative">
      <calculation class='tableau' formula="SUM([order_total]) / COUNTD([order_id])" />
    </column>
    <column caption="Repeat Order %" datatype="real" default-format="p0.0%" name="[Calc_RepeatPct]" role="measure" type="quantitative">
      <calculation class='tableau' formula='SUM(IIF([new_vs_repeat] = "Repeat", 1, 0)) / COUNT([order_id])' />
    </column>
    <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
  </datasource>
