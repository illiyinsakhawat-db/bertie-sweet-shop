    <column caption="Repeat Buyer Rate" datatype="real" default-format="p0.0%" name="[Calc_RepeatBuyer]" role="measure" type="quantitative">
      <calculation class='tableau' formula="SUM([repeat_buyers]) / SUM([buyers])" />
    </column>
    <column caption="Top 10 Product" datatype="boolean" name="[Calc_Top10]" role="dimension" type="nominal">
      <calculation class='tableau' formula="[overall_rank] &lt;= 10" />
    </column>
