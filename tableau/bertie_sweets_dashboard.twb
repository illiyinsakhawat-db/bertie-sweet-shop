            <column datatype="date" name="last_order_date" ordinal="4" />
            <column datatype="date" name="cohort_month" ordinal="5" />
            <column datatype="integer" name="order_count" ordinal="6" />
            <column datatype="real" name="lifetime_value" ordinal="7" />
            <column datatype="real" name="avg_order_value" ordinal="8" />
            <column datatype="real" name="avg_days_between_orders" ordinal="9" />
            <column datatype="string" name="customer_segment" ordinal="10" />
        </columns>
      </relation>
    </connection>
    <aliases enabled='yes' />
    <column caption="Customer Id" datatype="integer" name="[customer_id]" role="dimension" type="ordinal" />
    <column caption="Region Name" datatype="string" name="[region_name]" role="dimension" type="nominal" />
    <column caption="Registered On" datatype="date" name="[registered_on]" role="dimension" type="ordinal" />
    <column caption="First Order Date" datatype="date" name="[first_order_date]" role="dimension" type="ordinal" />
    <column caption="Last Order Date" datatype="date" name="[last_order_date]" role="dimension" type="ordinal" />
    <column caption="Cohort Month" datatype="date" name="[cohort_month]" role="dimension" type="ordinal" />
    <column caption="Order Count" datatype="integer" name="[order_count]" role="measure" type="quantitative" />
    <column caption="Lifetime Value" datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[lifetime_value]" role="measure" type="quantitative" />
    <column caption="Avg Order Value" datatype="real" default-format='c"£"#,##0.00;-"£"#,##0.00' name="[avg_order_value]" role="measure" type="quantitative" />
    <column caption="Avg Days Between Orders" datatype="real" name="[avg_days_between_orders]" role="measure" type="quantitative" />
    <column caption="Customer Segment" datatype="string" name="[customer_segment]" role="dimension" type="nominal" />
    <column caption="% of Revenue" datatype="real" default-format="p0%" name="[Calc_RevShare]" role="measure" type="quantitative">
      <calculation class='tableau' formula="SUM([lifetime_value]) / MIN({FIXED : SUM([lifetime_value])})" />
    </column>
    <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.4' show-structure='true' />
  </datasource>
