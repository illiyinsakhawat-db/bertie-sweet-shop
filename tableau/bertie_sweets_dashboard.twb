  <worksheets>
    <worksheet name="KPI Revenue">
      <layout-options>
        <title>
          <formatted-text>
            <run>Total Revenue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Order Summary" name="federated.order_summary" />
          </datasources>
          <datasource-dependencies datasource="federated.order_summary">
            <column datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[order_total]" role="measure" type="quantitative" />
            <column-instance column="[order_total]" derivation="Sum" name="[sum:order_total:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-size' value='26' />
            <format attr='font-weight' value='bold' />
            <format attr='color' value='#4e2a84' />
            <format attr='text-align' value='center' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[federated.order_summary].[sum:order_total:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="KPI Orders">
      <layout-options>
        <title>
          <formatted-text>
            <run>Orders</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Order Summary" name="federated.order_summary" />
          </datasources>
          <datasource-dependencies datasource="federated.order_summary">
            <column datatype="integer" name="[order_id]" role="dimension" type="ordinal" />
            <column-instance column="[order_id]" derivation="CountD" name="[ctd:order_id:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-size' value='26' />
            <format attr='font-weight' value='bold' />
            <format attr='color' value='#4e2a84' />
            <format attr='text-align' value='center' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[federated.order_summary].[ctd:order_id:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="KPI Avg Order Value">
      <layout-options>
        <title>
          <formatted-text>
            <run>Avg Order Value</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Order Summary" name="federated.order_summary" />
          </datasources>
          <datasource-dependencies datasource="federated.order_summary">
            <column caption="Avg Order Value" datatype="real" default-format='c"£"#,##0.00;-"£"#,##0.00' name="[Calc_AOV]" role="measure" type="quantitative">
              <calculation class='tableau' formula="SUM([order_total]) / COUNTD([order_id])" />
            </column>
            <column-instance column="[Calc_AOV]" derivation="User" name="[usr:Calc_AOV:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-size' value='26' />
            <format attr='font-weight' value='bold' />
            <format attr='color' value='#4e2a84' />
            <format attr='text-align' value='center' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[federated.order_summary].[usr:Calc_AOV:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="KPI Repeat Order %">
      <layout-options>
        <title>
          <formatted-text>
            <run>Repeat Order Rate</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Order Summary" name="federated.order_summary" />
          </datasources>
          <datasource-dependencies datasource="federated.order_summary">
            <column caption="Repeat Order %" datatype="real" default-format="p0.0%" name="[Calc_RepeatPct]" role="measure" type="quantitative">
              <calculation class='tableau' formula='SUM(IIF([new_vs_repeat] = "Repeat", 1, 0)) / COUNT([order_id])' />
            </column>
            <column-instance column="[Calc_RepeatPct]" derivation="User" name="[usr:Calc_RepeatPct:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='font-size' value='26' />
            <format attr='font-weight' value='bold' />
            <format attr='color' value='#4e2a84' />
            <format attr='text-align' value='center' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[federated.order_summary].[usr:Calc_RepeatPct:qk]" />
            </encodings>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="Revenue Trend by Category">
      <table>
        <view>
          <datasources>
            <datasource caption="Monthly Category Revenue" name="federated.monthly_category_revenue" />
          </datasources>
          <datasource-dependencies datasource="federated.monthly_category_revenue">
            <column datatype="string" name="[category_name]" role="dimension" type="nominal" />
            <column datatype="date" name="[order_month]" role="dimension" type="ordinal" />
            <column datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[revenue]" role="measure" type="quantitative" />
            <column-instance column="[category_name]" derivation="None" name="[none:category_name:nk]" pivot='key' type="nominal" />
            <column-instance column="[revenue]" derivation="Sum" name="[sum:revenue:qk]" pivot='key' type="quantitative" />
            <column-instance column="[order_month]" derivation="Month-Trunc" name="[tmn:order_month:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Area" />
            <encodings>
              <color column="[federated.monthly_category_revenue].[none:category_name:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.monthly_category_revenue].[sum:revenue:qk]</rows>
        <cols>[federated.monthly_category_revenue].[tmn:order_month:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Top 10 Products">
      <table>
        <view>
          <datasources>
            <datasource caption="Product Performance" name="federated.product_performance" />
          </datasources>
          <datasource-dependencies datasource="federated.product_performance">
            <column caption="Top 10 Product" datatype="boolean" name="[Calc_Top10]" role="dimension" type="nominal">
              <calculation class='tableau' formula="[overall_rank] &lt;= 10" />
            </column>
            <column datatype="string" name="[category_name]" role="dimension" type="nominal" />
            <column datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[net_revenue]" role="measure" type="quantitative" />
            <column datatype="string" name="[product_name]" role="dimension" type="nominal" />
            <column-instance column="[Calc_Top10]" derivation="None" name="[none:Calc_Top10:nk]" pivot='key' type="nominal" />
            <column-instance column="[category_name]" derivation="None" name="[none:category_name:nk]" pivot='key' type="nominal" />
            <column-instance column="[product_name]" derivation="None" name="[none:product_name:nk]" pivot='key' type="nominal" />
            <column-instance column="[net_revenue]" derivation="Sum" name="[sum:net_revenue:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <filter class='categorical' column="[federated.product_performance].[none:Calc_Top10:nk]">
            <groupfilter function='member' level="[none:Calc_Top10:nk]" member="true" user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <sort class='computed' column="[federated.product_performance].[none:product_name:nk]" direction="DESC" using="[federated.product_performance].[sum:net_revenue:qk]" />
          <slices>
            <column>[federated.product_performance].[none:Calc_Top10:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.product_performance].[none:category_name:nk]" />
              <text column="[federated.product_performance].[sum:net_revenue:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.product_performance].[none:product_name:nk]</rows>
        <cols>[federated.product_performance].[sum:net_revenue:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Category Revenue by Year">
      <table>
        <view>
          <datasources>
            <datasource caption="Order Line Sales" name="federated.order_line_sales" />
          </datasources>
          <datasource-dependencies datasource="federated.order_line_sales">
            <column datatype="string" name="[category_name]" role="dimension" type="nominal" />
            <column datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[net_revenue]" role="measure" type="quantitative" />
            <column datatype="date" name="[order_date]" role="dimension" type="ordinal" />
            <column-instance column="[category_name]" derivation="None" name="[none:category_name:nk]" pivot='key' type="nominal" />
            <column-instance column="[net_revenue]" derivation="Sum" name="[sum:net_revenue:qk]" pivot='key' type="quantitative" />
            <column-instance column="[order_date]" derivation="Year" name="[yr:order_date:ok]" pivot='key' type="ordinal" />
          </datasource-dependencies>
          <sort class='computed' column="[federated.order_line_sales].[none:category_name:nk]" direction="DESC" using="[federated.order_line_sales].[sum:net_revenue:qk]" />
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.order_line_sales].[yr:order_date:ok]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.order_line_sales].[none:category_name:nk]</rows>
        <cols>([federated.order_line_sales].[yr:order_date:ok] / [federated.order_line_sales].[sum:net_revenue:qk])</cols>
      </table>
    </worksheet>
    <worksheet name="New vs Repeat Orders">
      <table>
        <view>
          <datasources>
            <datasource caption="Order Summary" name="federated.order_summary" />
          </datasources>
          <datasource-dependencies datasource="federated.order_summary">
            <column datatype="string" name="[new_vs_repeat]" role="dimension" type="nominal" />
            <column datatype="integer" name="[order_id]" role="dimension" type="ordinal" />
            <column datatype="date" name="[order_month]" role="dimension" type="ordinal" />
            <column-instance column="[order_id]" derivation="CountD" name="[ctd:order_id:qk]" pivot='key' type="quantitative" />
            <column-instance column="[new_vs_repeat]" derivation="None" name="[none:new_vs_repeat:nk]" pivot='key' type="nominal" />
            <column-instance column="[order_month]" derivation="Month-Trunc" name="[tmn:order_month:ok]" pivot='key' type="ordinal" />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.order_summary].[none:new_vs_repeat:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.order_summary].[ctd:order_id:qk]</rows>
        <cols>[federated.order_summary].[tmn:order_month:ok]</cols>
      </table>
    </worksheet>
    <worksheet name="Revenue by Customer Segment">
      <table>
        <view>
          <datasources>
            <datasource caption="Customer Summary" name="federated.customer_summary" />
          </datasources>
          <datasource-dependencies datasource="federated.customer_summary">
            <column caption="% of Revenue" datatype="real" default-format="p0%" name="[Calc_RevShare]" role="measure" type="quantitative">
              <calculation class='tableau' formula="SUM([lifetime_value]) / MIN({FIXED : SUM([lifetime_value])})" />
            </column>
            <column datatype="string" name="[customer_segment]" role="dimension" type="nominal" />
            <column datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[lifetime_value]" role="measure" type="quantitative" />
            <column-instance column="[customer_segment]" derivation="None" name="[none:customer_segment:nk]" pivot='key' type="nominal" />
            <column-instance column="[lifetime_value]" derivation="Sum" name="[sum:lifetime_value:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_RevShare]" derivation="User" name="[usr:Calc_RevShare:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <sort class='computed' column="[federated.customer_summary].[none:customer_segment:nk]" direction="DESC" using="[federated.customer_summary].[sum:lifetime_value:qk]" />
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.customer_summary].[none:customer_segment:nk]" />
              <text column="[federated.customer_summary].[usr:Calc_RevShare:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.customer_summary].[none:customer_segment:nk]</rows>
        <cols>[federated.customer_summary].[sum:lifetime_value:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Cohort Retention">
      <table>
        <view>
          <datasources>
            <datasource caption="Cohort Retention" name="federated.cohort_retention" />
          </datasources>
          <datasource-dependencies datasource="federated.cohort_retention">
            <column caption="Retention %" datatype="real" default-format="p0%" name="[Calc_Retention]" role="measure" type="quantitative">
              <calculation class='tableau' formula="SUM([active_customers]) / SUM([cohort_customers])" />
            </column>
            <column datatype="date" name="[cohort_month]" role="dimension" type="ordinal" />
            <column datatype="integer" name="[months_since_first]" role="dimension" type="ordinal" />
            <column-instance column="[months_since_first]" derivation="None" name="[none:months_since_first:ok]" pivot='key' type="ordinal" />
            <column-instance column="[cohort_month]" derivation="Quarter-Trunc" name="[tqr:cohort_month:ok]" pivot='key' type="ordinal" />
            <column-instance column="[Calc_Retention]" derivation="User" name="[usr:Calc_Retention:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <filter class='categorical' column="[federated.cohort_retention].[none:months_since_first:ok]">
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level="[none:months_since_first:ok]" member="1" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="2" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="3" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="4" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="5" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="6" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="7" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="8" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="9" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="10" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="11" />
              <groupfilter function='member' level="[none:months_since_first:ok]" member="12" />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.cohort_retention].[none:months_since_first:ok]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Square" />
            <encodings>
              <color column="[federated.cohort_retention].[usr:Calc_Retention:qk]" />
              <text column="[federated.cohort_retention].[usr:Calc_Retention:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.cohort_retention].[tqr:cohort_month:ok]</rows>
        <cols>[federated.cohort_retention].[none:months_since_first:ok]</cols>
      </table>
    </worksheet>
    <worksheet name="Product Repeat-Buy Matrix">
      <table>
        <view>
          <datasources>
            <datasource caption="Product Performance" name="federated.product_performance" />
          </datasources>
          <datasource-dependencies datasource="federated.product_performance">
            <column caption="Repeat Buyer Rate" datatype="real" default-format="p0.0%" name="[Calc_RepeatBuyer]" role="measure" type="quantitative">
              <calculation class='tableau' formula="SUM([repeat_buyers]) / SUM([buyers])" />
            </column>
            <column datatype="string" name="[category_name]" role="dimension" type="nominal" />
            <column datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[net_revenue]" role="measure" type="quantitative" />
            <column datatype="string" name="[product_name]" role="dimension" type="nominal" />
            <column datatype="integer" name="[units_sold]" role="measure" type="quantitative" />
            <column-instance column="[category_name]" derivation="None" name="[none:category_name:nk]" pivot='key' type="nominal" />
            <column-instance column="[product_name]" derivation="None" name="[none:product_name:nk]" pivot='key' type="nominal" />
            <column-instance column="[net_revenue]" derivation="Sum" name="[sum:net_revenue:qk]" pivot='key' type="quantitative" />
            <column-instance column="[units_sold]" derivation="Sum" name="[sum:units_sold:qk]" pivot='key' type="quantitative" />
            <column-instance column="[Calc_RepeatBuyer]" derivation="User" name="[usr:Calc_RepeatBuyer:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Circle" />
            <encodings>
              <color column="[federated.product_performance].[none:category_name:nk]" />
              <size column="[federated.product_performance].[sum:net_revenue:qk]" />
              <lod column="[federated.product_performance].[none:product_name:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.product_performance].[usr:Calc_RepeatBuyer:qk]</rows>
        <cols>[federated.product_performance].[sum:units_sold:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Revenue by Region">
      <table>
        <view>
          <datasources>
            <datasource caption="Order Line Sales" name="federated.order_line_sales" />
          </datasources>
          <datasource-dependencies datasource="federated.order_line_sales">
            <column datatype="real" default-format='c"£"#,##0;-"£"#,##0' name="[net_revenue]" role="measure" type="quantitative" />
            <column datatype="string" name="[region_name]" role="dimension" type="nominal" />
            <column-instance column="[region_name]" derivation="None" name="[none:region_name:nk]" pivot='key' type="nominal" />
            <column-instance column="[net_revenue]" derivation="Sum" name="[sum:net_revenue:qk]" pivot='key' type="quantitative" />
          </datasource-dependencies>
          <sort class='computed' column="[federated.order_line_sales].[none:region_name:nk]" direction="DESC" using="[federated.order_line_sales].[sum:net_revenue:qk]" />
          <aggregation value='true' />
        </view>
        <style>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class="Bar" />
            <encodings>
              <text column="[federated.order_line_sales].[sum:net_revenue:qk]" />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.order_line_sales].[none:region_name:nk]</rows>
        <cols>[federated.order_line_sales].[sum:net_revenue:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Sales Performance">
